# G4L Platform — environment template.
# Copy to `.env.local` and fill in. NEVER commit real values (see .gitignore / governance).

# --- Anthropic (Member Agent; Founder Agent is P3) ---
ANTHROPIC_API_KEY=                 # SECRET. Server-side only — never expose to the browser.
ANTHROPIC_MODEL=claude-sonnet-4-6  # default working model for the agent runtime

# --- Supabase (Postgres + Auth + Storage + Realtime) ---
NEXT_PUBLIC_SUPABASE_URL=          # public — project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # public — anon key (RLS-guarded)
SUPABASE_SERVICE_ROLE_KEY=         # SECRET. Server-side only. Bypasses RLS — guard carefully.

# --- HubSpot (CRM spine + transactional email; email rail used by Founder Agent, P3) ---
HUBSPOT_PRIVATE_APP_TOKEN=         # SECRET. Server-side only.

# --- Integrations (wired post-MVP; placeholders so config is discoverable) ---
# STRIPE_SECRET_KEY=               # SECRET — billing (P2)
# CIRCLE_API_TOKEN=                # SECRET — community
# TOVUTI_API_KEY=                  # SECRET — LMS
