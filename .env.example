# G4L Platform — environment template.
# Copy to `.env.local` and fill in. NEVER commit real values (see .gitignore / governance).

# --- Anthropic (Member Agent; Founder Agent is P3) ---
ANTHROPIC_API_KEY=                 # SECRET. Server-side only — never expose to the browser.
ANTHROPIC_MODEL=claude-sonnet-4-6  # default working model for the agent runtime

# --- Database (production: hosted Supabase Postgres) ---
# When set, the app uses hosted Postgres; when unset, it falls back to local pglite (dev).
# Use the Supabase POOLER connection string (Supavisor, transaction mode, port 6543).
DATABASE_URL=                      # SECRET. e.g. postgresql://postgres.<ref>:<pw>@<region>.pooler.supabase.com:6543/postgres

# --- Supabase (Auth + Storage; needed for Path B / real members, not Path A demo) ---
NEXT_PUBLIC_SUPABASE_URL=          # public — project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # public — anon key (RLS-guarded)
SUPABASE_SERVICE_ROLE_KEY=         # SECRET. Server-side only. Bypasses RLS — guard carefully.

# --- HubSpot (CRM spine + transactional email; email rail used by Founder Agent, P3) ---
HUBSPOT_PRIVATE_APP_TOKEN=         # SECRET. Server-side only.

# --- Strava (activity connect; Path B — consent-gated health data) ---
# Register the app at https://www.strava.com/settings/api. Authorization Callback Domain must be
# your deployed origin's host (e.g. app.grintaforlife.com); localhost for dev.
STRAVA_CLIENT_ID=                  # public-ish client id
STRAVA_CLIENT_SECRET=              # SECRET. Server-side only — never in the repo or logs.
# 32-byte AES key (base64) that encrypts OAuth tokens AT REST + signs the OAuth state.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ACTIVITY_TOKEN_KEY=                # SECRET. Set in .env.local + Vercel. Rotating it invalidates stored tokens.

# --- Cron (Vercel attaches this as a Bearer token to scheduled routes; gates /api/cron/*) ---
CRON_SECRET=                       # SECRET. Server-side only.

# --- Operator diagnostic (read-only member report at GET /api/admin/member-diagnostic?q=…) ---
DIAGNOSTIC_READ_TOKEN=             # SECRET, read-only. UNSET => route 404s (feature OFF). Bearer-gated. Exposes member data; rotate it.

# --- Integrations (wired post-MVP; placeholders so config is discoverable) ---
# STRIPE_SECRET_KEY=               # SECRET — billing (P2)
# CIRCLE_API_TOKEN=                # SECRET — community
# TOVUTI_API_KEY=                  # SECRET — LMS
