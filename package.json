{
  "name": "g4l-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:verify": "node --experimental-strip-types scripts/db/verify.ts",
    "db:reset": "rm -rf .pglite && echo 'local dev DB wiped — restart the dev server to recreate it'",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/db/migrate.ts",
    "db:seed-demo": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/db/seed-demo.ts",
    "agent:check": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/agent/check.ts",
    "db:set-demo-password": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/db/set-demo-password.ts",
    "smoke": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@supabase/supabase-js": "^2.45.0",
    "next": "^15.1.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "playwright": "^1.61.0",
    "typescript": "^5.7.0"
  }
}
